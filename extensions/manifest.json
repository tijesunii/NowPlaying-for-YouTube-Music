{
  "manifest_version": 3,
  "name": "NowPlaying for YouTube™ Music",
  "version": "1.1",
  "description": "Custom Chrome Extension to track YouTube Music and update a webhook.",
  "options_page": "options.html",
  "action": {
    "default_popup": "options.html",
    "default_title": "NowPlaying Settings"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
